# GNU Stow ignore list for this package.
#
# A pattern without "/" matches a basename at any depth.
# A pattern with "/" matches the path from the repo root, which starts with "/".
# Use the "/" form for repo-only entries, or the rule hides nested files too.

# ---
# Version control and tool state
# ---
^/\.git$
^/\.github$
^/\.serena$
^/\.gitignore$
^/\.gitconfig$
^/\.gitignore_global$
^/\.stowrc$
^/\.stow-local-ignore$

# ---
# Repo-only directories
# ---
^/bin$
^/journal$
^/macos$
^/utils$

# ---
# Repo-only files
# ---
^/CHANGELOG\.md$
^/CLAUDE\.md$
^/Dockerfile$
^/Justfile$
^/LICENSE$
^/Makefile$
^/README\.md$
^/TODO\.md$
^/cliff\.toml$
^/docker-compose\.yml$
^/pam_biometric\.so$
^/todo\.txt$

# ---
# Machine-local: keep in the repo, do not link
# ---
^/\.lima$
^/\.ssh$
^/\.gnupg$
^/\.claude/settings\.local\.json$
^/\.config/opencode/opencode\.json$

# ---
# Junk, any depth
# ---
^.*\.DS_Store$
^.*\.swp$
^.*\.code-workspace$
^.+~$
^\#.*\#$
